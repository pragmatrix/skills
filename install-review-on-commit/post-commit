#!/bin/sh

# review-on-commit post-commit hook.
#
# Reviews each new commit with the `review` skill in a headless Claude Code
# run, but only while an interactive Claude Code session is open in this
# worktree. The run is read-only: it gets the file reading tools and Bash
# limited to read-only git commands. It messages a start notice and its
# findings to the open sessions and ends. Its final answer, the findings, goes
# to .git/review-on-commit/<sha>.log. Runs are named review-<sha>, and the hook
# never counts them as open sessions.

command -v claude >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# A rebase runs this hook once per replayed commit. Those commits were
# reviewed before, so the hook stays silent while a rebase is in progress.
for state in rebase-merge rebase-apply; do
    [ -d "$(git rev-parse --git-path "$state")" ] && exit 0
done

top=$(git rev-parse --show-toplevel) || exit 0

# The names of the open interactive sessions in this worktree, comma-separated.
sessions=$(claude agents --json 2>/dev/null | jq -r --arg top "$top" '
    [.[] | select(.kind == "interactive"
            and .name != null
            and (.name | startswith("review-") | not)
            and (.cwd == $top or (.cwd | startswith($top + "/"))))
     | .name] | join(", ")
')
[ -n "$sessions" ] || exit 0

sha=$(git rev-parse HEAD)
short=$(git rev-parse --short HEAD)
subject=$(git log -1 --format=%s HEAD)
logdir=$(git rev-parse --path-format=absolute --git-path review-on-commit)
log=$logdir/$short.log
mkdir -p "$logdir" || exit 0

prompt="/review commit $sha

This review runs in the background, after the commit was made. Review commit $sha as a self-contained change. Read it with \`git show $sha\` and judge it against its own diff, even where the checkout already holds later commits. Read any further code and history the review needs. Tests are not run here, so judge them by reading them.

Report through SendMessage to each of these Claude Code sessions: $sessions.

1. Before reviewing, send: \"Background review of $short ($subject) started. No reply is needed. Mention it to the user only before a push or finalize, or when they ask about reviews.\"
2. After reviewing, send the complete findings under this header: \"Background review of $short ($subject) finished. No reply is needed. At the end of your current reply, tell the user briefly how many findings there are and what the most severe one is, and offer to go through them. Change nothing based on this review without the user's go-ahead.\" When there are no findings, send only: \"Background review of $short ($subject): no findings. No reply is needed. Mention it to the user in one line at the end of your current reply.\"

End with the complete findings as your final answer. It is saved as the review log."

nohup claude -p "$prompt" \
    --name "review-$short" \
    --no-session-persistence \
    --permission-prompts none \
    --permission-mode dontAsk \
    --strict-mcp-config \
    --tools "Read,Grep,Glob,Skill,SendMessage,Bash" \
    --allowedTools "Bash(git log:*)" "Bash(git show:*)" "Bash(git diff:*)" "Bash(git blame:*)" \
    </dev/null >"$log" 2>&1 &

printf 'review-on-commit: reviewing %s in the background, log: %s\n' "$short" "$log" >&2
