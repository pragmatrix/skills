#!/bin/sh

# review-on-push pre-push hook.
#
# Reviews the commits a push sends, together as one change, with each skill in
# review_skills, but only while an interactive Claude Code session is open in
# this worktree, or in a superproject directory that contains it. Each skill
# gets a headless Claude Code run of its own, started in the background, so the
# push goes through at once. A run is read-only: it gets the file reading tools
# and Bash limited to read-only git commands. A skill whose folder holds an
# executable named prepare may also call that script, which builds what the
# review reads without changing the working tree. Don't-ask mode denies reads
# outside the working directories, so the skills folder the review reads is
# added as a directory. A run messages its findings to the open sessions, which
# handle them with the handle-reviews skill, and ends. Its final answer, the
# findings, goes to .git/review-on-push/<skill>-<sha>.log. Runs are named
# review-<skill>-<sha>, and the hook never counts them as open sessions.

command -v claude >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# The commits the push sends that no remote branch holds yet, newest first.
# Git passes one line per pushed ref on stdin.
pushed=
while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a branch or pushing a tag sends no commits to review.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    new=$(git rev-list "$local_sha" --not --remotes)
    # After a rebase, a commit with a new id may carry the same changes as one
    # the remote branch already has. Those were reviewed before, so only the
    # commits that git cherry marks as new to the old remote branch remain.
    case "$remote_sha" in *[!0]*)
        if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            changed=$(git cherry "$remote_sha" "$local_sha" | sed -n 's/^+ //p')
            kept=
            for commit in $new; do
                printf '%s\n' "$changed" | grep -qx "$commit" && kept="$kept $commit"
            done
            new=$kept
        fi
        ;;
    esac
    for commit in $new; do
        case " $pushed " in *" $commit "*) ;; *) pushed="$pushed $commit" ;; esac
    done
done

# A commit whose subject ends in "(review-fix)" only applies the findings of an
# earlier review. The commit skill writes that tag. Reviewing such a commit
# would review a review, so the hook leaves it out and reviews go one level deep.
kept=
for commit in $pushed; do
    case $(git log -1 --format=%s "$commit") in
    *'(review-fix)') ;;
    *) kept="$kept $commit" ;;
    esac
done
pushed=$kept
[ -n "$pushed" ] || exit 0

top=$(git rev-parse --show-toplevel) || exit 0

# A submodule's commits are also reviewed for sessions in its superprojects, so
# the outermost superproject bounds where such a session may run.
outer=$top
while super=$(git -C "$outer" rev-parse --show-superproject-working-tree 2>/dev/null) &&
    [ -n "$super" ]; do
    outer=$super
done

# The names of the open interactive sessions that see this worktree,
# comma-separated: those inside it, and those in a superproject directory that
# contains it. A session in a sibling submodule does not count.
agents=$(claude agents --json 2>/dev/null) || {
    printf 'review-on-push: claude agents failed, no review started\n' >&2
    exit 0
}
sessions=$(printf '%s\n' "$agents" | jq -r --arg top "$top" --arg outer "$outer" '
    def within($dir): . == $dir or startswith($dir + "/");
    [.[] | select(.kind == "interactive"
            and .name != null
            and (.name | startswith("review-") | not))
     | .cwd as $cwd
     | select(($cwd | within($top)) or (($cwd | within($outer)) and ($top | within($cwd))))
     | .name] | join(", ")
')
[ -n "$sessions" ] || exit 0

# rev-list lists the newest commit first, and the review reads them oldest first.
set -- $pushed
newest=$1
oldest_first=
for commit in "$@"; do
    oldest_first="$commit $oldest_first"
done
count=$#
short=$(git rev-parse --short "$newest")
subject=$(git log -1 --format=%s "$newest")
logdir=$(git rev-parse --path-format=absolute --git-path review-on-push)
mkdir -p "$logdir" || exit 0

# The review skills this hook runs, each in a run of its own. install.sh fills
# in the list.
review_skills='review'

# The review skills and the skills they load, such as rust-code-review with its
# standards file, are read from the skills folder this hook was installed from.
# install.sh fills in that folder twice. skills_dir is the path install.sh was
# run by. skills_dir_resolved is the same folder with symlinks resolved, because
# the skill folders may be symlinks into a clone that lies elsewhere.
skills_dir=
skills_dir_resolved=
skills=$skills_dir
[ -d "$skills" ] || skills=$skills_dir_resolved
set --
[ -d "$skills_dir" ] && set -- --add-dir "$skills_dir"
[ -d "$skills_dir_resolved" ] && [ "$skills_dir_resolved" != "$skills_dir" ] &&
    set -- "$@" --add-dir "$skills_dir_resolved"

# Starts one review run in the background. The arguments are the run's name,
# its log, its prompt, one extra allowed tool or an empty string, and then the
# --add-dir options.
start_review() {
    run_name=$1
    run_log=$2
    run_prompt=$3
    run_extra=$4
    shift 4
    nohup claude -p "$run_prompt" \
        --name "$run_name" \
        --no-session-persistence \
        --permission-prompts none \
        --permission-mode dontAsk \
        --strict-mcp-config \
        "$@" \
        --tools "Read,Grep,Glob,Skill,SendMessage,Bash" \
        --allowedTools "Bash(git log:*)" "Bash(git show:*)" "Bash(git diff:*)" "Bash(git blame:*)" \
        ${run_extra:+"$run_extra"} \
        </dev/null >"$run_log" 2>&1 &
}

for skill in $review_skills; do
    log=$logdir/$skill-$short.log
    # A log for the same head means this skill reviewed these commits
    # already, for example by a `git push --dry-run`, which runs this hook
    # too, or by a push that is repeated.
    if [ -e "$log" ]; then
        printf 'review-on-push: %s review of commits up to %s ran already, log: %s\n' \
            "$skill" "$short" "$log" >&2
        continue
    fi
    extra=
    prepare_note=
    if [ -x "$skills/$skill/prepare" ]; then
        extra="Bash($skills/$skill/prepare:*)"
        prepare_note=" The skill's preparation script is allowed too, called by this exact path as the command itself: $skills/$skill/prepare"
    fi

    prompt="/$skill the pushed commits $oldest_first

This review runs in the background, while the commits are pushed. Review these $count commits together as one change, oldest first: $oldest_first. Read each with \`git show <sha>\`, and judge the change as a whole, so a problem that a later commit of these fixes is no finding. Read any further code and history the review needs. Tests are not run here, so judge them by reading them. Run git from the current directory, without \`cd\` or \`git -C\`, because only plain \`git log\`, \`git show\`, \`git diff\` and \`git blame\` are allowed.$prepare_note

When the review is done, send its complete findings through SendMessage to each of these Claude Code sessions: $sessions. Start the message with: \"The $skill review of $count pushed commits up to $short ($subject) finished. Handle it with the handle-reviews skill.\" When there are no findings, send only: \"The $skill review of $count pushed commits up to $short ($subject) finished with no findings. Handle it with the handle-reviews skill.\"

End with the complete findings as your final answer. It is saved as the review log."

    start_review "review-$skill-$short" "$log" "$prompt" "$extra" "$@"
    printf 'review-on-push: %s review of %s commits up to %s in the background, log: %s\n' "$skill" "$count" "$short" "$log" >&2
done
